{
  "name": "@air/demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:engine": "npm --prefix ../engine run build",
    "dev": "npm run build:engine && tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck:local": "tsc --noEmit",
    "typecheck": "npm run build:engine && npm run typecheck:local",
    "test": "vitest run",
    "test:live-github": "vitest run test/e2e/task-scenarios.e2e.test.ts"
  },
  "dependencies": {
    "@air/engine": "file:../engine",
    "fastify": "^5.6.2",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
